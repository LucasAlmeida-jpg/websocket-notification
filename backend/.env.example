APP_NAME="Notification System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Banco de dados ───────────────────────────────────────────────────────────
# SQLite por padrão. Para MySQL/Postgres, troque DB_CONNECTION e preencha os campos abaixo.
DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/backend/database/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=notification_system
# DB_USERNAME=root
# DB_PASSWORD=

# ─── Broadcast / WebSocket ────────────────────────────────────────────────────
# Requer Soketi rodando: soketi start --config=soketi.json
BROADCAST_DRIVER=pusher

# ─── Cache / Queue ───────────────────────────────────────────────────────────
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Queue processa notificações assíncronas. Rode: php artisan queue:work
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@notificationsystem.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Soketi / Pusher ──────────────────────────────────────────────────────────
# Credenciais locais do Soketi (devem bater com soketi.json)
# Para usar Pusher cloud: troque HOST/PORT/SCHEME e coloque as credenciais do dashboard
PUSHER_APP_ID=local-app
PUSHER_APP_KEY=local-key
PUSHER_APP_SECRET=local-secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Gere as chaves com: php artisan vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@notificationsystem.local

# ─── Vite / Frontend ─────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
